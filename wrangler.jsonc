{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "san-roque-parish",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "san-roque-parish" }],
  // Incremental cache uses KV; ISR queue and Sanity Live tag cache use Durable Objects.
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "9b53de798f174997ba5d3a97e27c0fb5" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }],
  // next/image optimization via Cloudflare Images
  "images": { "binding": "IMAGES" }
}
