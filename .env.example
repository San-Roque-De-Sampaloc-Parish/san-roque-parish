NEXT_PUBLIC_SANITY_PROJECT_ID=""
# "production" for real parish content, or "preview" for realistic fabricated
# content used for visual/design QA. Never point a deployed environment at
# "preview" — switch this only in your local .env.local (gitignored).
NEXT_PUBLIC_SANITY_DATASET="production"

# Site URL — used for sitemap, Open Graph, and canonical URLs
NEXT_PUBLIC_SITE_URL="https://sanroqueparish.ph"

# Resend — https://resend.com/api-keys
RESEND_API_KEY=""

# Email recipients
CONTACT_TO_EMAIL=""
PRAYER_TO_EMAIL=""

# Sender address — must be a verified domain in Resend (e.g. "Parish <noreply@yourdomain.com>")
EMAIL_FROM=""

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAGIaMmdn8SCVlf3R"
TURNSTILE_SECRET_KEY=""
# Local development may include local hosts. Production must list only the
# deployed frontend hostname(s), without localhost or 127.0.0.1.
TURNSTILE_HOSTNAMES="localhost,127.0.0.1,san-roque-parish.srdsp1987.workers.dev"

# Google Places API (New) — https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
